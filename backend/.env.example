# ============================================================
# Beta API Hub by Sonic Network — Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ============================================================

# ============================================================
# Site Branding & Identity (Change anytime without touching code)
# ============================================================
APP_NAME="Beta API Hub"
COMPANY_NAME="Sonic Network"
BRAND_BADGE_LETTER=""
SUPPORT_EMAIL="support@sonicnetwork.dev"
SITE_META_DESCRIPTION="Purchase API access plans, manage unique developer keys, test live endpoints, and scale with Razorpay."
API_KEY_PREFIX_LIVE="beta_live_"
API_KEY_PREFIX_TEST="beta_test_"
RECEIPT_PREFIX="BETA"

APP_ENV="development"
APP_PUBLIC_URL="http://localhost:8000"
# Public URL of standalone Frontend (e.g. https://your-site.vercel.app); leave empty if same-origin
FRONTEND_URL=""
HOST="0.0.0.0"
PORT=8000

# Security Secrets (GENERATE STRONG RANDOM STRINGS IN PRODUCTION)
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="replace-with-a-64-char-random-secret-key-in-production"
# Optional dedicated 32-byte Fernet key:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=""

# Database URL
# Local zero-config SQLite:
DATABASE_URL="sqlite:///./beta_hub.db"
# Neon / Cloud PostgreSQL (pooled with SSL):
# DATABASE_URL="postgresql://user:pass@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require&channel_binding=require"

# ============================================================
# Master / Upstream Backend API Configuration
# NEVER exposed to frontend users.
# ============================================================
GATEWAY_MODE="hybrid"
UPSTREAM_API_BASE_URL=""
MASTER_API_KEY="sn_master_replace_with_your_real_upstream_master_key"
UPSTREAM_AUTH_HEADER="Authorization"
UPSTREAM_AUTH_SCHEME="Bearer"
UPSTREAM_TIMEOUT_MS=10000

# Built-in Media / Song / Video API Settings (Optional overrides — also manageable in Admin UI)
MEDIA_API_ENABLED=true
MEDIA_MAX_DURATION_SECONDS=1200
MEDIA_MAX_FILE_SIZE_MB=250
YOUTUBE_API_KEY=""
YOUTUBE_COOKIES_B64=""

# ============================================================
# Razorpay Payment Gateway Credentials
# Test keys start with rzp_test_... | Live keys start with rzp_live_...
# ============================================================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ============================================================
# Google OAuth 2.0 Credentials
# Authorized Redirect URI: {APP_PUBLIC_URL}/api/auth/google/callback
# ============================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/google/callback"

# ============================================================
# SMTP Email Delivery (Verification, Password Reset, Receipts)
# Leave SMTP_HOST blank in development to capture emails in the local outbox.
# ============================================================
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@sonicnetwork.dev"
SMTP_FROM_NAME=""
SMTP_USE_TLS=true

# ============================================================
# Initial Admin Seed Account (Created only if no admin exists)
# ============================================================
INITIAL_ADMIN_EMAIL="admin@sonicnetwork.dev"
INITIAL_ADMIN_PASSWORD="SonicAdmin!2026ChangeMe"
INITIAL_ADMIN_NAME="Sonic Network Admin"

# Telegram Bot Integration (Optional here — can also be connected live via Website UI)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_API_BASE_URL="https://api.telegram.org"
TELEGRAM_WEBHOOK_ENABLED=true
TELEGRAM_POLLING_ENABLED=true

# Cookie & CORS Settings
COOKIE_SECURE=false
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

